# Copy this file to .env and fill in your values

# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Anthropic API key (required when using anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key (required when using openai)
# OPENAI_API_KEY=sk-your-key-here

# Model for story building (defaults: claude-opus-4-0-20250514 for anthropic, gpt-4o for openai)
# LLM_MODEL=claude-opus-4-0-20250514

# Model for the game loop — cheaper than the story-building model.
# If not set, falls back to LLM_MODEL.
# (defaults: claude-sonnet-4-20250514 for anthropic, gpt-4o for openai)
# LLM_GAMELOOP_MODEL=claude-sonnet-4-20250514

# Game language (default: English). The LLM will generate all narrative,
# choices, and world content in this language. Examples: German, French, Spanish
# GAME_LANGUAGE=English

# Optional: custom OpenAI-compatible base URL (for local models, Azure, etc.)
# OPENAI_BASE_URL=http://localhost:1234/v1

# --- UI Mode ---
# "terminal" (default) — classic retro text adventure with ASCII art
# "audiobook" — interactive audiobook with voice narration and speech input
#   Requires: OPENAI_API_KEY (for TTS/STT) and ffmpeg installed for mic recording
# "web" — web server with mobile-friendly audiobook UI (play from your phone!)
#   Requires: OPENAI_API_KEY (for TTS/STT)
# UI_MODE=terminal

# --- Web Mode Settings ---
# Port for the web server (default: 3006)
# WEB_PORT=3006

# Optional password to protect the web interface
# WEB_PASSWORD=

# TTS voice for audiobook mode (default: nova)
# Options: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
# TTS_VOICE=nova

# TTS narration style instruction (default: dramatic audiobook narrator).
# When GAME_LANGUAGE is set to a non-English language, a native-accent directive is automatically
# appended to the default style. If you set TTS_STYLE manually, add your own language instruction.
# TTS_STYLE=Speak as a dramatic audiobook narrator. Use a slow, atmospheric pace with expressive intonation.

# Microphone device name override for Windows (auto-detected if omitted).
# List available devices: ffmpeg -list_devices true -f dshow -i dummy
# RECORD_DEVICE=Microphone (Realtek Audio)
